# Dockerfile for NeoDesk Server (Go)
# Multi-stage build: compile from source, then copy to minimal runtime image
#
# The NeoDesk server is a single binary that replaces both hbbs and hbbr.
# It provides: signal (UDP/TCP/WS), relay (TCP/WS), HTTP API, admin console.
#
# Build, from the repository's root: docker build -f docker/Dockerfile.server -t neodesk-server:local .

# ---- Web app build (embedded in the binary, DECISIONS A25) ----
FROM node:22.23.2-alpine3.24 AS web-ui-builder

WORKDIR /web-ui

# npm 10 (bundled with Node 22) fails to resolve this dependency tree (ci.yml)
COPY web-ui/package.json web-ui/package-lock.json ./
RUN npx -y npm@11.6.2 ci --no-audit --no-fund

# The web app build generates the remote viewer's protobuf code from the
# server's schema (web-ui/vite-plugins/protos.ts reads ../neodesk-server/protos)
COPY neodesk-server/protos/ /neodesk-server/protos/
COPY web-ui/ .
RUN npm run build

# ---- Build stage ----
FROM golang:1.26.11-alpine AS builder
ARG TARGETARCH

RUN apk add --no-cache git || { sleep 2 && apk add --no-cache git; }

WORKDIR /src

# Copy Go module files first (cache dependencies)
COPY neodesk-server/go.mod neodesk-server/go.sum ./

RUN go mod download

# Copy full source
COPY neodesk-server/ .

# The binary carries the web app, as the release binaries do
COPY --from=web-ui-builder /web-ui/build /web-ui-build
RUN go run ./cmd/embed-webui -from /web-ui-build

# The binary's version, build date and commit (-version, the update check).
# Without build arguments: the version in VERSION and the time of the build;
# the commit only when NEODESK_COMMIT_SHA names it (the publish workflow
# and install/docker-compose.single.yml pass it).
ARG NEODESK_PRODUCT_VERSION=
ARG NEODESK_COMMIT_SHA=
ARG NEODESK_BUILD_DATE=

# Build static binary (modernc.org/sqlite is pure Go — no CGO needed)
RUN version="${NEODESK_PRODUCT_VERSION:-$(tr -d '[:space:]' < VERSION)}" && \
    built="${NEODESK_BUILD_DATE:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" && \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags="-s -w -X main.Version=${version} -X main.Commit=${NEODESK_COMMIT_SHA} -X main.BuildDate=${built}" \
    -tags "netgo osusergo" \
    -o /neodesk-server .

# ---- Runtime stage ----
FROM alpine:3.22

LABEL maintainer="neodeskapp"
LABEL description="NeoDesk Server - RustDesk-compatible signal + relay"
LABEL org.opencontainers.image.source="https://github.com/neodeskapp/neodesk"
LABEL version="3.6.7"

RUN apk add --no-cache \
    ca-certificates \
    curl \
    sqlite \
    tini \
    su-exec \
    shadow \
    || { sleep 2 && apk add --no-cache \
    ca-certificates curl sqlite tini su-exec shadow; } \
    && addgroup -g 10001 -S neodesk \
    && adduser -u 10001 -S -G neodesk neodesk

COPY --from=builder /neodesk-server /usr/local/bin/neodesk-server
RUN chmod +x /usr/local/bin/neodesk-server \
    && ln -s neodesk-server /usr/local/bin/neodesk

# Create data directory before writing build metadata into it
# The data volume is mounted at /opt/neodesk/data (docker/data-path.sh)
RUN mkdir -p /opt/neodesk/data && chown neodesk:neodesk /opt/neodesk/data

ARG NEODESK_COMMIT_SHA=unknown
ARG NEODESK_IMAGE_VERSION=unknown
ENV NEODESK_IMAGE_SHA=${NEODESK_COMMIT_SHA}
ENV NEODESK_IMAGE_VERSION=${NEODESK_IMAGE_VERSION}
RUN printf '%s\n' "${NEODESK_COMMIT_SHA}" > /opt/neodesk/data/.image-commit

# Entrypoint script: fixes volume permissions, then drops to neodesk user
COPY docker/ensure-app-user.sh /ensure-app-user.sh
COPY docker/server-entrypoint.sh /server-entrypoint.sh
COPY docker/data-path.sh /docker/data-path.sh
COPY docker/bootstrap-admin-credentials.sh /docker/bootstrap-admin-credentials.sh
COPY docker/show-admin-credentials.sh /usr/local/bin/neodesk-show-admin-credentials
COPY docker/healthcheck.sh /usr/local/bin/neodesk-healthcheck
RUN chmod +x /ensure-app-user.sh /server-entrypoint.sh /docker/bootstrap-admin-credentials.sh /usr/local/bin/neodesk-show-admin-credentials /usr/local/bin/neodesk-healthcheck

WORKDIR /opt/neodesk/data

# Server only: the console in this binary is on by default (DECISIONS A27)
# and stays off in this image; the neodesk image runs both in one process
ENV CONSOLE_PORT=0

# Ports:
# 21121 - HTTP API (RustDesk client API + REST)
# 21122 - CDAP gateway (custom devices and agents)
# 21115 - NAT type test
# 21116 - Signal (TCP+UDP)
# 21117 - Relay (TCP)
# 21118 - WebSocket Signal
# 21119 - WebSocket Relay
# 21123 - Relay node control (NODE_CONTROL_PORT, 0 turns it off)
# 21125 - Relay node legs from other sites' nodes (MODE=node, NODE_LEG_PORT)
EXPOSE 21115 21116/tcp 21116/udp 21117 21118 21119 21121 21122 21123 21125

# Health check via the API (the console is off here), over HTTPS with TLS_API
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD /usr/local/bin/neodesk-healthcheck

# Note: Container starts as root so entrypoint can fix volume permissions.
# server-entrypoint.sh drops to neodesk user via su-exec before running the server.

ENTRYPOINT ["/sbin/tini", "--", "/server-entrypoint.sh"]
CMD ["/usr/local/bin/neodesk-server", "-mode", "all", "-api-port", "21121", "-key-file", "/opt/neodesk/data/id_ed25519"]
